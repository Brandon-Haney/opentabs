{
  "name": "@opentabs-dev/opentabs-plugin-servicenow",
  "description": "OpenTabs plugin for ServiceNow",
  "version": "0.0.87",
  "type": "module",
  "main": "dist/adapter.iife.js",
  "keywords": [
    "opentabs-plugin",
    "opentabs",
    "mcp",
    "modelcontextprotocol",
    "chrome-extension",
    "ai-agent",
    "browser-automation"
  ],
  "opentabs": {
    "displayName": "ServiceNow",
    "description": "OpenTabs plugin for ServiceNow",
    "urlPatterns": [
      "*://*.service-now.com/*"
    ],
    "configSchema": {
      "instanceUrl": {
        "type": "url",
        "label": "Instance URL",
        "description": "The URL of your ServiceNow instance if it uses a custom domain (e.g., https://support.example.com). Leave empty for standard *.service-now.com instances.",
        "required": false,
        "placeholder": "https://support.example.com"
      }
    },
    "iconSvg": "<svg viewBox=\"0 0 32 32\" xmlns=\"http://www.w3.org/2000/svg\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M16.05 1.70001C7.4 1.70001 0.15 8.80001 0 17.6C0 22.25 1.95 26.4 5.05 29.4C6.2 30.45 7.9 30.55 9.2 29.65C11 28.2 13.35 27.45 16.05 27.45C18.75 27.45 21.1 28.35 22.9 29.65C24.2 30.55 25.9 30.55 27.05 29.4C30.15 26.4 31.95 22.4 31.95 17.75C31.8 8.80001 24.8 1.70001 16 1.70001M15.95 25.65C11.15 25.65 7.9 22 7.9 17.6C7.9 13.2 11.15 9.55001 15.95 9.55001C20.75 9.55001 24 13.2 24 17.6C24 22 20.75 25.65 15.95 25.65Z\" fill=\"#62D84E\"/></svg>",
    "iconDarkSvg": "<svg viewBox=\"0 0 32 32\" xmlns=\"http://www.w3.org/2000/svg\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M16.05 1.70001C7.4 1.70001 0.15 8.80001 0 17.6C0 22.25 1.95 26.4 5.05 29.4C6.2 30.45 7.9 30.55 9.2 29.65C11 28.2 13.35 27.45 16.05 27.45C18.75 27.45 21.1 28.35 22.9 29.65C24.2 30.55 25.9 30.55 27.05 29.4C30.15 26.4 31.95 22.4 31.95 17.75C31.8 8.80001 24.8 1.70001 16 1.70001M15.95 25.65C11.15 25.65 7.9 22 7.9 17.6C7.9 13.2 11.15 9.55001 15.95 9.55001C20.75 9.55001 24 13.2 24 17.6C24 22 20.75 25.65 15.95 25.65Z\" fill=\"#62D84E\"/></svg>"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && opentabs-plugin build",
    "dev": "tsc --watch --preserveWatchOutput & opentabs-plugin build --watch",
    "type-check": "tsc --noEmit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --fix src/",
    "format:check": "biome format src/",
    "format": "biome format --write src/",
    "check": "npm run build && npm run type-check && npm run lint && npm run format:check"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@opentabs-dev/plugin-sdk": "^0.0.114"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@opentabs-dev/plugin-tools": "^0.0.114",
    "jiti": "^2.6.1",
    "typescript": "^6.0.3",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opentabs-dev/opentabs.git",
    "directory": "plugins/servicenow"
  }
}
